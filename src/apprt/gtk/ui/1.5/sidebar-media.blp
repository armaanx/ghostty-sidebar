using Gtk 4.0;
using Adw 1;

// Compact now-playing card: album cover with previous / play-pause / next
// stacked below it. The track title and artist are the cover's tooltip.
template $GhosttySidebarMedia: Adw.Bin {
  styles [
    "sidebar-media",
  ]

  visible: false;

  child: Gtk.Box {
    orientation: vertical;
    spacing: 6;
    halign: center;

    Adw.Bin art_frame {
      styles [
        "media-art",
      ]

      overflow: hidden;
      halign: center;

      // GtkImage draws the cover at exactly pixel-size, unlike GtkPicture
      // which asks for the image's full resolution.
      Gtk.Image art {
        pixel-size: 88;
        icon-name: "audio-x-generic-symbolic";
      }
    }

    Gtk.Box {
      orientation: horizontal;
      spacing: 6;
      halign: center;

      Gtk.Button {
        styles [
          "flat",
          "circular",
          "media-button",
        ]

        valign: center;
        icon-name: "media-skip-backward-symbolic";
        tooltip-text: _("Previous");
        can-focus: false;
        focus-on-click: false;
        clicked => $previous_clicked();
      }

      Gtk.Button play_button {
        styles [
          "circular",
          "media-button",
          "media-play",
        ]

        valign: center;
        icon-name: "media-playback-start-symbolic";
        tooltip-text: _("Play/Pause");
        can-focus: false;
        focus-on-click: false;
        clicked => $play_pause_clicked();
      }

      Gtk.Button {
        styles [
          "flat",
          "circular",
          "media-button",
        ]

        valign: center;
        icon-name: "media-skip-forward-symbolic";
        tooltip-text: _("Next");
        can-focus: false;
        focus-on-click: false;
        clicked => $next_clicked();
      }
    }
  };
}
