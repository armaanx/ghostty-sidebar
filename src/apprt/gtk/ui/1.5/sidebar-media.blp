using Gtk 4.0;
using Adw 1;

// Compact now-playing card: small album cover, play/pause and next.
// The track title and artist are the cover's tooltip.
template $GhosttySidebarMedia: Adw.Bin {
  styles [
    "sidebar-media",
  ]

  visible: false;

  child: Gtk.Box {
    orientation: horizontal;
    spacing: 8;

    Adw.Bin art_frame {
      styles [
        "media-art",
      ]

      overflow: hidden;
      valign: center;
      halign: start;
      hexpand: true;

      // GtkImage draws the cover at exactly pixel-size, unlike GtkPicture
      // which asks for the image's full resolution.
      Gtk.Image art {
        pixel-size: 36;
        icon-name: "audio-x-generic-symbolic";
      }
    }

    Gtk.Button play_button {
      styles [
        "circular",
        "media-button",
        "media-play",
      ]

      valign: center;
      icon-name: "media-playback-start-symbolic";
      tooltip-text: _("Play/Pause");
      can-focus: false;
      focus-on-click: false;
      clicked => $play_pause_clicked();
    }

    Gtk.Button {
      styles [
        "flat",
        "circular",
        "media-button",
      ]

      valign: center;
      icon-name: "media-skip-forward-symbolic";
      tooltip-text: _("Next");
      can-focus: false;
      focus-on-click: false;
      clicked => $next_clicked();
    }
  };
}
