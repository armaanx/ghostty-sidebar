  section {
    item {
      label: _("New Window");
      action: "win.new-window";
    }

    item {
      label: _("Close Window");
      action: "win.close";
    }
  }

  section {
    item {
      label: _("Change Tab Title…");
      action: "win.prompt-tab-title";
    }

    submenu {
      label: _("Tab Color");

      item {
        label: _("None");
        action: "win.set-active-tab-color";
        target: "none";
      }

      item {
        label: _("Red");
        action: "win.set-active-tab-color";
        target: "red";
      }

      item {
        label: _("Orange");
        action: "win.set-active-tab-color";
        target: "orange";
      }

      item {
        label: _("Yellow");
        action: "win.set-active-tab-color";
        target: "yellow";
      }

      item {
        label: _("Green");
        action: "win.set-active-tab-color";
        target: "green";
      }

      item {
        label: _("Teal");
        action: "win.set-active-tab-color";
        target: "teal";
      }

      item {
        label: _("Blue");
        action: "win.set-active-tab-color";
        target: "blue";
      }

      item {
        label: _("Purple");
        action: "win.set-active-tab-color";
        target: "purple";
      }

      item {
        label: _("Pink");
        action: "win.set-active-tab-color";
        target: "pink";
      }

      item {
        label: _("Gray");
        action: "win.set-active-tab-color";
        target: "gray";
      }
    }

    item {
      label: _("New Tab");
      action: "win.new-tab";
    }

    item {
      label: _("Close Tab");
      action: "win.close-tab";
      target: "this";
    }
  }

  section {
    submenu {
      label: _("Split");

      item {
        label: _("Change Title…");
        action: "win.prompt-surface-title";
      }

      item {
        label: _("Split Up");
        action: "win.split-up";
      }

      item {
        label: _("Split Down");
        action: "win.split-down";
      }

      item {
        label: _("Split Left");
        action: "win.split-left";
      }

      item {
        label: _("Split Right");
        action: "win.split-right";
      }
    }
  }

  section {
    item {
      label: _("Clear");
      action: "win.clear";
    }

    item {
      label: _("Reset");
      action: "win.reset";
    }
  }

  section {
    item {
      label: _("Cycle Tab Sidebar");
      action: "win.cycle-tab-sidebar";
    }

    submenu {
      label: _("Sidebar Theme");

      item {
        label: _("Follow System");
        action: "win.sidebar-theme";
        target: "auto";
      }

      item {
        label: _("Graphite");
        action: "win.sidebar-theme";
        target: "graphite";
      }

      item {
        label: _("Charcoal");
        action: "win.sidebar-theme";
        target: "charcoal";
      }

      item {
        label: _("Midnight");
        action: "win.sidebar-theme";
        target: "midnight";
      }

      item {
        label: _("Slate");
        action: "win.sidebar-theme";
        target: "slate";
      }

      item {
        label: _("Nord");
        action: "win.sidebar-theme";
        target: "nord";
      }

      item {
        label: _("Mocha");
        action: "win.sidebar-theme";
        target: "mocha";
      }

      item {
        label: _("Paper (Light)");
        action: "win.sidebar-theme";
        target: "paper";
      }
    }

    submenu {
      label: _("Sidebar Accent");

      item {
        label: _("Blue");
        action: "win.sidebar-accent";
        target: "4ea1ff";
      }

      item {
        label: _("Purple");
        action: "win.sidebar-accent";
        target: "a78bfa";
      }

      item {
        label: _("Green");
        action: "win.sidebar-accent";
        target: "4ade80";
      }

      item {
        label: _("Teal");
        action: "win.sidebar-accent";
        target: "2dd4bf";
      }

      item {
        label: _("Orange");
        action: "win.sidebar-accent";
        target: "fb923c";
      }

      item {
        label: _("Pink");
        action: "win.sidebar-accent";
        target: "f472b6";
      }

      item {
        label: _("Red");
        action: "win.sidebar-accent";
        target: "f87171";
      }

      item {
        label: _("Yellow");
        action: "win.sidebar-accent";
        target: "facc15";
      }

      item {
        label: _("White");
        action: "win.sidebar-accent";
        target: "e5e7eb";
      }
    }

    item {
      label: _("Glass Sidebar");
      action: "win.sidebar-glass";
    }
  }

  section {
    item {
      label: _("Command Palette");
      action: "win.toggle-command-palette";
    }

    item {
      label: _("Terminal Inspector");
      action: "win.toggle-inspector";
    }

    item {
      label: _("Open Configuration");
      action: "app.open-config";
    }

    item {
      label: _("Reload Configuration");
      action: "app.reload-config";
    }
  }

  section {
    item {
      label: _("About Ghostty");
      action: "win.about";
    }

    item {
      label: _("Quit");
      action: "app.quit";
    }
  }
}

menu tab_context_menu {
  item {
    label: _("Change Tab Title…");
    action: "win.prompt-context-tab-title";
  }

  item {
    label: _("Pin or Unpin Tab");
    action: "win.toggle-pin-tab";
  }

  submenu {
    label: _("Tab Color");

    item {
      label: _("None");
      action: "win.set-tab-color";
      target: "none";
    }

    item {
      label: _("Red");
      action: "win.set-tab-color";
      target: "red";
    }

    item {
      label: _("Orange");
      action: "win.set-tab-color";
      target: "orange";
    }

    item {
      label: _("Yellow");
      action: "win.set-tab-color";
      target: "yellow";
    }

    item {
      label: _("Green");
      action: "win.set-tab-color";
      target: "green";
    }

    item {
      label: _("Teal");
      action: "win.set-tab-color";
      target: "teal";
    }

    item {
      label: _("Blue");
      action: "win.set-tab-color";
      target: "blue";
    }

    item {
      label: _("Purple");
      action: "win.set-tab-color";
      target: "purple";
    }

    item {
      label: _("Pink");
      action: "win.set-tab-color";
      target: "pink";
    }

    item {
      label: _("Gray");
      action: "win.set-tab-color";
      target: "gray";
    }
  }
}
